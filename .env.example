# Marzban panel
MARZBAN_BASE_URL=https://panel.persepolisconstruction.co.uk:8000
MARZBAN_ADMIN_USERNAME=admin_vpn
MARZBAN_ADMIN_PASSWORD=change_me
MARZBAN_INBOUND_TAG=VLESS_WS_TLS

# Crypto payment — self-hosted USDT (TRC20) wallet. Customer sends the exact
# plan price to TRON_USDT_WALLET_ADDRESS, then submits their transaction hash
# on the pay page; we verify it on-chain via TronGrid and auto-confirm.
# TRON_USDT_WALLET_ADDRESS is a PUBLIC receiving address only — never put a
# private key here. Leave empty to disable crypto payments entirely.
TRON_USDT_WALLET_ADDRESS=
# Free API key from https://www.trongrid.io (sign up, dashboard -> create key)
TRONGRID_API_KEY=

# Second crypto network — Polygon (optional, offered alongside Tron above).
# Leave both empty to disable it and only offer Tron.
POLYGON_USDT_WALLET_ADDRESS=
# Free API key from https://polygonscan.com (sign up, dashboard -> API keys)
POLYGONSCAN_API_KEY=

# NowPayments (legacy — no longer used for crypto checkout)
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=

# Order behaviour
ORDER_EXPIRY_MINUTES=30

# Card/bank payment (Stripe) — alternative to crypto. Leave STRIPE_SECRET_KEY
# empty to disable card payments entirely (site still works with crypto only).
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# Set once you create the webhook endpoint in the Stripe dashboard (Developers
# → Webhooks) pointing at /api/payments/stripe/webhook.
STRIPE_WEBHOOK_SECRET=

# Used only when running the app directly (no Docker) — inside docker-compose,
# the `app` service overrides this to point at the `db` Postgres container instead.
DATABASE_URL=sqlite:///./freemiga.db
# Postgres password for docker-compose's `db` service. Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(24))"
POSTGRES_PASSWORD=change_me

SITE_BASE_URL=https://shop.persepolisconstruction.co.uk

# Session cookie signing — generate a real random value with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=change_me_to_a_random_64_char_hex_string
# Keep "true" in production (behind nginx/Cloudflare HTTPS). Set "false" ONLY
# for local http://127.0.0.1 testing, otherwise the login cookie won't be sent.
SESSION_COOKIE_SECURE=true

# Login for THIS site's admin panel (/admin) — separate from Marzban's own
# admin account on purpose.
ADMIN_USERNAME=shopadmin
ADMIN_PASSWORD=change_me

# Telegram bot (optional) — used to notify customers when their VPN is
# ready/renewed/banned, and to deliver password-reset codes. Leave
# TELEGRAM_BOT_TOKEN empty to disable this entirely (site still works fine
# without it, customers just won't get Telegram notifications).
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=FreemigaBot
# Your own Telegram chat id (see README for how to find it) — lets the bot
# DM you about new orders, new support tickets, and provisioning failures.
ADMIN_TELEGRAM_CHAT_ID=

# Direct support contact — shown as buttons in the bot's support menu.
# Leave empty to hide that button.
TELEGRAM_SUPPORT_USERNAME=
SUPPORT_EMAIL=

# Email (Resend) — required for signup email verification. Get an API key
# at resend.com. Without a verified sending domain there, Resend only
# delivers to your own account email — fine for testing, not production.
RESEND_API_KEY=
RESEND_FROM_EMAIL=Freemiga <onboarding@resend.dev>

# Shared secret for the separate marzban-guard abuse-detection system to
# report account restrictions to POST /api/integrations/marzban-guard/status
# (must match that project's shop_integration.webhook_secret). Leave empty
# to keep the endpoint disabled.
MARZBAN_GUARD_WEBHOOK_SECRET=

# The other direction: this shop pushes each plan's device-count allowance
# to marzban-guard's admin API whenever an order is provisioned (must match
# that project's admin_api.api_key). Leave MARZBAN_GUARD_BASE_URL empty to
# skip this — plans just won't have a per-plan device limit enforced.
MARZBAN_GUARD_BASE_URL=
MARZBAN_GUARD_ADMIN_API_KEY=

# Language (see README for GeoIP setup — site works fine without the
# .mmdb file, new visitors just always default to DEFAULT_LANGUAGE)
GEOIP_DB_PATH=app/data/GeoLite2-Country.mmdb
DEFAULT_LANGUAGE=en
PERSIAN_COUNTRIES=IR,AF

SITE_NAME=Freemiga
